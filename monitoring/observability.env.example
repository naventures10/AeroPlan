# Grafana Cloud Connection Configurations
# Copy this file to a local '.env' file in this directory and populate with credentials from Grafana Cloud

# 1. Grafana Cloud API / Token (Used for authentication across exporters)
GRAFANA_CLOUD_API_KEY=your_grafana_cloud_token_or_api_key

# 2. Prometheus (Metrics) Remote Write Settings
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=your_prometheus_user_id

# 3. Loki (Logs) Push Settings
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-006.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=your_loki_user_id

# 4. Tempo (Traces) OTLP/HTTP Settings
# For OTLP, Grafana Cloud typically exposes a unified HTTP endpoint
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
GRAFANA_CLOUD_OTLP_USER=your_otlp_user_id
