{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}", "src/tests/**/*.{ts,tsx}"],
  "ignorePatterns": ["src/types/api.generated.ts"],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["src/tests/**"]
  },
  "health": {
    "maxCyclomatic": 9999,
    "maxCognitive": 9999,
    "maxCrap": 9999.0,
    "ignore": [
      "src/features/map/layers/createAirspaceLayers.ts",
      "src/utils/metarParser.ts",
      "src/features/map/tooltips/useMapTooltip.ts"
    ]
  },
  "rules": {
    "unused-dependencies": "warn",
    "unused-exports": "warn",
    "unused-files": "warn"
  }
}
