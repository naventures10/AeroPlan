{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:types": "./scripts/generate-types.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit": "mkdir -p lighthouse-reports && npx lighthouse http://localhost:4173 --output html --output json --output-path ./lighthouse-reports/lighthouse-report.html --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "@deck.gl/core": "~9.2.6",
    "@deck.gl/extensions": "~9.2.6",
    "@deck.gl/geo-layers": "~9.2.6",
    "@deck.gl/layers": "~9.2.6",
    "@deck.gl/mapbox": "~9.2.6",
    "@deck.gl/react": "~9.2.6",
    "@grafana/faro-react": "^2.7.1",
    "@grafana/faro-web-sdk": "^2.7.0",
    "@grafana/faro-web-tracing": "^2.7.1",
    "@luma.gl/core": "~9.2.6",
    "@luma.gl/engine": "~9.2.6",
    "@luma.gl/shadertools": "~9.2.6",
    "@oddbird/css-anchor-positioning": "^0.9.0",
    "@oddbird/popover-polyfill": "^0.6.1",
    "dompurify": "^3.3.3",
    "framer-motion": "^12.38.0",
    "geotiff": "^3.0.5",
    "interestfor": "^1.0.8",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.1.0",
    "react-pdf": "^10.4.1",
    "react-router": "^7.14.2",
    "tailwindcss": "^4.2.1",
    "weatherlayers-gl": "^2026.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fallow": "^2.88.3",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.3"
  }
