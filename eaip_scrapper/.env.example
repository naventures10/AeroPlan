# LLM API Keys (LlamaCloud allows multiple keys for rotation)
LLAMA_CLOUD_API_KEY_1=your_llama_cloud_api_key_1
LLAMA_CLOUD_API_KEY_2=your_llama_cloud_api_key_2
LLAMA_CLOUD_API_KEY_3=your_llama_cloud_api_key_3
LLAMA_CLOUD_API_KEY_4=your_llama_cloud_api_key_4

# Mistral OCR API Key (Fallback for OCR extraction)
MISTRAL_API_KEY=your_mistral_api_key

# MinIO Config
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=ais

# ERC Crop Polygon (WGS84 Coordinates: list of [lng, lat] pairs)
ERC_MAP_POLYGON="[[60.0,-6.0],[60.0,25.0],[65.74,25.0],[66.5,37.5],[83.0,37.35],[83.0,30.0],[98.5,30.0],[98.5,5.0],[70.4,5.0],[70.4,-6.0],[60.0,-6.0]]"

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aeronautical_information_system
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
